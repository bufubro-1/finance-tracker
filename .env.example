# Choose an initial reporting currency and its scale explicitly.
# Supported pairs: EUR/2, GBP/2, JPY/0, KWD/3, TRY/2, USD/2.
FINANCE_TRACKER_REPORTING_CURRENCY=
FINANCE_TRACKER_MINOR_UNIT_SCALE=
# Relative paths are resolved against the directory from which you launch.
FINANCE_TRACKER_DATABASE_PATH=data/finance_tracker.sqlite3
FINANCE_TRACKER_GEMINI_ENABLED=false
FINANCE_TRACKER_TELEGRAM_ENABLED=false
# No credentials are needed or used by the TASK-001 runtime shell.
